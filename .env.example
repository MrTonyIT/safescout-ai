# ==============================================================================
# SafeScout AI (The Secret Explorer Academy) - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite default)
DATABASE_URL="file:./dev.db"

# Internal flags
INTERNAL_LEARNING_PREVIEW=false
FAMILY_LEARNING_ENABLED=false
WEB_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"

# Google Gemini API Configuration
# Leave GEMINI_API_KEY empty to run in Safe Fallback Mode (offline mock responses)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Parent Gate Security & Auth Defaults (For development/testing)
PARENT_DEFAULT_PIN="1234"
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"
