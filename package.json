{
  "name": "safescout-ai-backend",
  "version": "1.0.0",
  "description": "SafeScout AI (The Secret Explorer Academy) - Autonomous Child Safety, Survival Skills & Reflex Learning Platform",
  "author": "SafeScout AI Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "node --test test/workflow.test.cjs test/family-http.test.cjs test/backup.test.cjs test/curriculum.test.cjs test/experience.test.cjs test/game-feedback.test.cjs test/explorer-maze.test.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "preview": "node scripts/start-preview.cjs",
    "preview:curriculum": "node scripts/start-preview.cjs --curriculum",
    "curriculum:packet": "node scripts/create-review-packet.cjs",
    "test:browser": "node scripts/run-browser-checks.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "axios": "^1.20.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
